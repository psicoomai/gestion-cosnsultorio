# Copia este archivo como .env.local para desarrollo, o configura estas
# variables en Vercel (Settings → Environment Variables) para producción.

# Base de datos PostgreSQL (Neon, Supabase…). Sin ella, en desarrollo se usa
# una base local en .data/pglite.
DATABASE_URL=

# Llave para cifrar los datos de cada consultorio: 64 caracteres hexadecimales.
# Genérala una sola vez (p. ej. `openssl rand -hex 32`) y guárdala en un lugar
# seguro: si se pierde, los datos guardados ya no se pueden leer.
DATA_ENCRYPTION_KEY=
