# Copia este archivo como .env.local y ajusta los valores.

# Base de datos. Por defecto un archivo SQLite local (ideal para un servidor propio).
# Para Vercel u otro hosting sin disco persistente usa Turso:
#   DATABASE_URL=libsql://tu-base.turso.io
#   DATABASE_AUTH_TOKEN=...
DATABASE_URL=file:./data/abanico.db
DATABASE_AUTH_TOKEN=

# URL pública de la app (se usa en los QR y en los enlaces que se mandan por WhatsApp).
# Si se deja vacía se toma del dominio con el que se abrió la página.
APP_URL=

# Código que pide la pantalla de configuración inicial (crear la cuenta de la dueña/o).
# Obligatorio en producción para que nadie más pueda reclamar la cuenta.
SETUP_CODE=

# Zona horaria para "sellos de hoy" y las gráficas.
APP_TIMEZONE=America/Mexico_City

# Opcional: secreto para firmar sesiones. Si no se define se genera uno y se guarda en la base.
SESSION_SECRET=
